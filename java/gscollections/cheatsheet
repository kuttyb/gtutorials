MutableSet	    || Sets.mutable.with()
MutableSoftedSet    || TreeSortedSet.newSet()

MutableMap	    || Maps.mutable.with()
MutableSortedMap    || TreeSortedMap.newMap()

MutableMultimap     || Multimaps.mutable.sortedBag.empty() // Tree
		       Multimaps.mutable.set.empty()       // Hash

