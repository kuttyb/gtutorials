# To work on a remote branch
git checkout remotes/origin/branchcode

# To create a local branch at this changelist
git checkout -b mylocalbranch

# To create a mapping between the two branches so that pull/push finds the correct remote branch
git branch --set-upstream-to=origin/branchcode mylocalbranch

That's it!!
git pull --rebase  should do the trick hereafter


# This will ensure that when you push it will only push the current branch to the one
# git pull would pull from. The other is matching, which means all branches will update their
# changes to their matching remote ones (way too dangerous even when using staging branches for
# remote branches)
git config --global push.default simple

# If you want to explicitly control which remote branch you want to push your local
# branch changes to
git push origin La:Ra // where La is local and Ra is remote

