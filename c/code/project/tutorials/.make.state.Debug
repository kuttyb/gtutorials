.MAKE_VERSION:	VERSION-1.0
.build-conf:
	"/usr/share/studio/SolarisStudio12.2-solaris-x86-tar-ML/solstudio12.2/bin/dmake"  -f nbproject/Makefile-Release.mk dist/Release/OracleSolarisStudio_12.2-Solaris-Sparc/tutorials
.clean-conf:
	rm -f -r build/Release
	rm -f dist/Release/OracleSolarisStudio_12.2-Solaris-Sparc/tutorials
.BUILT_LAST_MAKE_RUN:
.depcheck-impl:
	echo "# This code depends on make tool being used" >.dep.inc
	if [ -n "" ]; then \
	    echo "DEPFILES=\$(wildcard \$(addsuffix .d, \${OBJECTFILES}))" >>.dep.inc; \
	    echo "ifneq (\${DEPFILES},)" >>.dep.inc; \
	    echo "include \${DEPFILES}" >>.dep.inc; \
	    echo "endif" >>.dep.inc; \
	else \
	    echo ".KEEP_STATE:" >>.dep.inc; \
	    echo ".KEEP_STATE_FILE:.make.state.\${CONF}" >>.dep.inc; \
	fi
