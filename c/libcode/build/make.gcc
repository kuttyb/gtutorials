CC         = gcc
LD         = gcc
OPTIMIZE   = -O3 -flto -fwhole-program
CFLAGS    += ${OPTIMIZE} -Wall -msse2 -march=native -std=gnu99  ${WORDSIZE} -c -I${INC}
DYNFLAGS   = ${OPTIMIZE} ${WORDSIZE} -shared -Wl,-soname,${LIBNAME}
DYNFLAGS2  =
BINFLAGS   = ${OPTIMIZE} ${WORDSIZE}

ifdef TARGET_LIBRARY
CFLAGS    += -fPIC
endif
