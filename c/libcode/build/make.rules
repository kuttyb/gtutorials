# Rules
${BIN}/%.o :: ${SRC}/%.c
	@echo $<
	${Q} ${CC} ${CFLAGS} $< -o $@

# App
BINSOURCES  = ${SOURCES}
BINSOURCES += ${MAIN}
${BINNAME} : $(patsubst %.c, ${BIN}/%.o, ${BINSOURCES})
	@echo "linking binary $@ ..."
	${Q} ${CC} ${BINFLAGS} -o ${BINNAME} $(patsubst %.c,${BIN}/%.o,${BINSOURCES})

# Dynamic Library
${LIBNAME} : $(patsubst %.c, ${BIN}/%.o, ${SOURCES})
	@echo "linking dynamic library $@ ..."
	${Q} ${CC} ${DYNFLAGS} -o ${LIBNAME} $(patsubst %.c,${BIN}/%.o,${SOURCES})

clean :
	@echo "cleaning ..."
	@rm  -rf ${BIN}/*.o ${LIBNAME} ${BINNAME}
