CC         = suncc
LD         = sunCC
OPTIMIZE   = -xO5 -xipo=2 -xipo_archive=writeback
CFLAGS     = ${OPTIMIZE} -xprefetch_level=3 -xarch=sse2 ${WORDSIZE} -c -I${INC}
DYNFLAGS   = ${OPTIMIZE} ${WORDSIZE} -G
DYNFLAGS2  = -Kpic 
BINFLAGS   = ${OPTIMIZE} ${WORDSIZE}

ifdef TARGET_LIBRARY
CFLAGS    += -Kpic
endif
