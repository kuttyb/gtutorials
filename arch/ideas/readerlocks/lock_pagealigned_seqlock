	Lock Page Aligned
========================================================================
This is my version of seqlock!!

typedef struct {
    unsigned long physOffset; // page offset /dev/shm/cthreads.pid

    void          *rptr;      // rptr and wptr are two page aligned VAs
    void          *wptr;      // used by readers and writers respectively!!

    int            status;    // 0 = RO  mode , 1 = W mode
} RWLock;

void readLock(RWLock* lock, void* src, void* dst, int bytes) {
     do {
     	v0    = rptr[0];

	memcpy(src, dst, bytes);

	v1    = rptr[0];
     } while(v1 != v0);
}

onReadFault(unsigned long addr) {
   RWLock* lock = hashGet(addr);
   
   barrier_full();
   while(lock->status) {
       /** do an adaptive sleep here if you must */
   }
}

void writeLock(RWLock* lock) {
    while(!CAS(lock->status, 0, 1)){} // grab writer lock
    PROT_NONE(rptr);
    barrier_release();
}

void writeUnlock(RWLock* lock) {
    atomicincr(wptr[0], 1);
    PROT_READ(rptr);
    CAS(lock->status, 1, 0);
}


