
System Value are annotations applied to variables
https://learn.microsoft.com/en-us/windows/win32/direct3dhlsl/dx-graphics-hlsl-semantics#system-value-semantics

SV_Position, SV_Depth, SV_Target (Color as written by Pixel Shaders)

------------------------------------------------------------------------------------
 Bare Minimum Skeletal Shaders
------------------------------------------------------------------------------------
// Vertex Shader
float4 main(void) : SV_POSITION {
  return float4(0.1, 0.2, 0.3, 1.0);
} 

// Pixel Shader
float4 main(void) : SV_TARGET {
  return float4(0.1, 0.2, 0.3, 1.0);
}

------------------------------------------------------------------------------------



------------------------------------------------------------------------------------
 Structs and input variables
------------------------------------------------------------------------------------
// Vertex Shader
struct Input {
  float4 pos : SV_POSITION
};

float4 main(Input input) : SV_POSITION {
  return input.pos + float4(0.1, 0.2, 0.3, 1.0);
} 

// Pixel Shader
float4 main(void) : SV_TARGET {
  return float4(0.1, 0.2, 0.3, 1.0);
}

