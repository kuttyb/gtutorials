Step 1: disable nwam and enable default
svcadm disable svc:/network/physical:nwam
svcadm enable  svc:/network/physical:default


Step 2:
ipadm create-addr -T static -a local=10.0.10.242/24 bge0/v4


Step 3: 
# ipadm show-addr
ADDROBJ TYPE STATE ADDR
lo0/v4 static ok 127.0.0.1/8
bge0/v4 static ok 10.0.10.242/24
lo0/v6 static ok ::1/128


Step 4:
# route -p add default 10.0.10.1
add net default: gateway 10.0.10.1
add persistent net default: gateway 10.0.10.1


Step 5:
cp /etc/nsswitch.dns /etc/nsswitch.conf
svcadm restart dns/client


Step 6:
/etc/netmasks 
Make sure you have
192.168.1.0   255.255.255.0   < essentially your first router address ~ 255.255.255.0 >

Step 7:
Make sure /etc/resolv.conf has 
nameserver $gateway

