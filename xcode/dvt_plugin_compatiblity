# This is where your plugins are anyways
~/Library/Application Support/Developer/Shared/Xcode/Plug-ins/Alcatraz.xcplugin

# For each plugin, Contents/Info.plist contains the DVT UUIT information (DVTPlugInCompatibilityUUIDs)

==================
[a] Get the UUID thus
defaults read /Applications/Xcode.app/Contents/Info DVTPlugInCompatibilityUUID

[b] psw_vers will list out the plugins it does not recogize

[c] Update them all thus. Remember to use complete paths and not relative paths.
defaults write ~/Library/Application\ Support/Developer/Shared/Xcode/Plug-ins/Auto-Importer.xcplugin/Contents/Info.plist    DVTPlugInCompatibilityUUIDs -array-add 992275C1-432A-4CF7-B659-D84ED6D42D3F

