// Print all possible combinations of a string. Consider 4 alphabets a,b,c,d, if repetitions are allowed then max is 4 else max is 3

Node { char c; bool halt;}

ArrayList<Node> nodeList = factor(max);

Node get(i) {
  node = allocatorFromNodeList();
  node.c = i;
  node.halt = false;
}


allPossibilities() {
  for (i = 0; i < max; ++i) {
     dfs(i);
  }
}

dfs(i) {
  push(get(i), 0);

  while (!empty()) {
  	n = pop();
	if (n.index == 0) {
	   /* Test for acceptance and do early culling by setting a halt bit in the node
	   visit(n, stack);
	}

	/* This is the early cull logic to avoid expanding trees that have no future ... */
	if (n.halt == true) {
	   n.halt = false;
	   continue;
	}

	if (n.index != max) {
	   /* Push the current node back again with a higher index */
	   push(n.node, n.index + 1);
	   /* Push a new node */
	   push(get(n.node.i + n.index), 0);
	}
  }
}

visit(node, stack) {
   if (stack.height == (max - 1)) {
      node.halt = true;
   }

   if (accept(stack) == false) {
      node.halt = true;
   }
}

