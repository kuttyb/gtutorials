            str[ctr] = (char) (digit + '0');
        }

        /* Reverse the string */
        for (ctr = 0; ctr < str.length / 2; ++ctr) {
            char temp = str[ctr];
            str[ctr] = str[str.length - 1 - ctr];
            str[str.length - 1 - ctr] = temp;
