	   case true: {
	   	while ((lo != hi) && (lo != last) && (state == true)) {
		      char c = a[lo];
		      /* By removing this char, are we still in the good state? */
		      if (requiredMap.get(c) == true) {
		      	 /* Alright, lets do a decrement of this characters count */
			 int count = countMap.get(c);
			 countMap.put(c, countMap.get(c) - 1);
			 /* ... meaning we are losing our state */
			 if (count == 0) {
			    state = false;
			    /* Record this range between [lo-hi] in a TreeMap<Integer(len), Pair<Integer, Inteer>> */
			    bestPath.put(hi - lo, new Pair<>(lo, hi));
			 }
