while ((lo != last) && (hi != last)) {
     switch (state) {
     	   case false: {
	   	while ((hi != last) && (state == false)) {
	   	      char c = a[hi];	    
		      /* This is a character of interest */
		      if (requiredMap.get(c) == true) {
		      	 countMap.put(c, countMap.get(c) + 1);
			 currentMap.put(c, true);
			 /* With this new variable we have a match */
			 if (currentMap.equals(requiredMap) == true) {
			    state = true;
			 } else {
