start from left to right ... for each node search the entire right side finding an element
smaller than it and swap. O(n^2)


for (i = 0; i < n; i++) {
    min      = a[i];
    minindex = i;
    for(j = i + 1; j < n; j++) {
    	  if (a[j] < min) {
	     min      = a[j];
	     minindex = j;
	  }
    }
    if (minindex != i) { 
       swap(a, i, minindex); 
    }
}
