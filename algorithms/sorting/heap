HEAP SORT:
   create heap in place from input array [1] // this  is O(n)
   for (i = 0; i < n; i++) {                 // this  is lg(n)
       swap(i, n - i);    // this is called min-delete
       heapify(i);        // since root is always the min node in a min-heap
   }


