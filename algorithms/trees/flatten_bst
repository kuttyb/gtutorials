serialize and deserialize a BST using Breadth First Search (thats really preorder traversal right?)

====================
SERIALIZE
====================
serialize(root, file) {
  push(root);
  
  while(!empty()){
    n = pop();
    WRITE(file, n); // Its ok if n is NULL store a standard NULL object in file

    if (n != NULL) {
        qpush(n->left); // add to FIFO
	qpush(n->right);
    }    
  }
}



====================
DESERIALIZE
====================
root deserialize(file) {
    root = READ();
    
    push(root);
    
    while(!fileempty && !stackempty) {
        n = pop();
	n->left   =  READ();
	n->right  =  READ();

	if (n->left)   qpush(n->right); // push order should match in serialize/deserialize
	if (n->right)  qpush(n->left);
    }
    
    return root;
}
