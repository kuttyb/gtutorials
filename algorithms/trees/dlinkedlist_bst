Q: Convert BST to a sorted dlinklist in place
A: 

dlinkify(root) {
  last = NULL;
  push(root);

  while(!empty()) {
    n = pop();

    if (ISPUSHED(n)) {
       if (last) {
       	  last->fwd = n;
       }
       n->back = last;
       last = n;
    } else {
      push(n->right);
      push(PUSHED(n));
      push(n->left);
    }
  }
}


