typedef struct {
    unsigned long *get;    // align get/put on separate cache lines
    unsigned long *put;

    void          *data[]; // initialized to value INIT
    unsigned long  size;
} FIFO;

#define INIT 0xffffffffffffUL

#define GET(fifo) *fifo->get

#define PUT(fifo) *fifo->put

#define ISEMPTY(get, put, size) ({ boolean a = false;\
	if (get == put) a = true;
	a;})

#define ISFULL(get, put, size) ({ boolean a = false;\
	if (get == ((put + 1) % size)) a = true;
	a;})

#define INCREMENT(fifo, var) (var + 1) % fifo->totalsize;

void produce(FIFO *fifo, void *data) {
     boolean value = false;
     
     do {
        localput = PUT(fifo);
     	if (!FULL(GET(fifo), localput, fifo->size) {

	   value = CAS(fifo->put, localput, INCREMENT(fifo, localput));
	}
     } while(value == false);	
     
     /** at this point this thread owns localput index feel free to update array */
     while (fifo->data[localput] == NULL) {}

     /** Deal here being we need to make sure previous consumer successfully
     	 consumed then NULL marked this index */
     fifo->data[localput] = data;
}


void * get(FIFO *fifo) {
     boolean value = false;
     
     do {
     	localget = GET(fifo);
	if (!EMPTY(localget, PUT(fifo), fifo->size)) {
	
	    value = CAS(fifo->get, localget, INCREMENT(fifo, localget));
        }
     } while(value == false);

     /** at this point this thread owns localget and can safely consume it */
     while ((fifo->data[localget] == INIT) || (fifo->data[localget] == NULL)) {}

     void *data = fifo->data[localget];

     return data;     
}

