pair<int, int> find(a, sum) {
lo = 0; high = end;

if (sum > (a[high] + a[high - 1])) return null;
if (sum < (a[lo] + a[lo +1])) return null;

while (lo < high) {
   
   expected = sum - lo;
   if (expected == a[high]) {
      return pair<lo, high>;
   }

   if (expected < high) {
      /* reduce high */
      --high;
   } else {
     /* advance low */
     ++low;
   }
}

}


