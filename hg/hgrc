ssh = ssh -C

[extensions]
record =
purge = 
graphlog = 
mq = 
rebase = 
hgext.bookmarks =
hgext.git =
color =
shelve =
evolve =
# These are covered by the evolve extension
#split =
#amend =
histedit =
progress =

[git]
intree=1
blockdotgit = false

[alias]
lists = qqueue -l
iist = qqueue $1
qp = qapplied
ql = qseries
qd = qdiff
lg = log --template '{node|short} | {date|isodatesec} | {author|user}: {desc|strip|firstline}\n'
__mystatus = status
st = !hg __mystatus $($HG root) $HG_ARGS
pager = LESS='FRX' less

[color]
custom.rev = yellow
custom.author = bold

